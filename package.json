{
  "name": "pump-sim",
  "version": "1.0.3",
  "description": "Open-source simulator of Companytec fuel concentrators (CBC/Horustech/Concept), faithful to the protocol and to SimuladorCBC 2.7.2.",
  "keywords": [
    "companytec",
    "horustech",
    "cbc",
    "identfid",
    "fuel",
    "gas-station",
    "fuel-pump",
    "simulator",
    "concentrator",
    "protocol",
    "mcp"
  ],
  "license": "MIT",
  "author": "Gabriel Martinusso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmartinu/pump-sim.git"
  },
  "homepage": "https://github.com/gmartinu/pump-sim#readme",
  "bugs": {
    "url": "https://github.com/gmartinu/pump-sim/issues"
  },
  "type": "module",
  "bin": {
    "pump-sim": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:sea:win": "npm run build && node tools/build-sea.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "ci": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run ci && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "postject": "1.0.0-alpha.6",
    "resedit": "3.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  }
}
